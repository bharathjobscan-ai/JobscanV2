{
  "name": "jobscan-v2",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:migrate": "drizzle-kit migrate",
    "db:generate": "drizzle-kit generate",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "worker": "node workers/ai/run.mjs",
    "worker:once": "node workers/ai/run.mjs --once",
    "test:integration": "vitest run --config vitest.integration.config.mts",
    "ai:report": "node scripts/ai-usage-report.mjs",
    "ai:models": "vitest run --config vitest.integration.config.mts tests/unit/gemini-models.itest.ts",
    "ai:bench": "vitest run --config vitest.integration.config.mts tests/integration/gemini-benchmark.itest.ts"
  },
  "dependencies": {
    "@google/genai": "^2.20.0",
    "date-fns": "^4.4.0",
    "docx": "^9.7.1",
    "drizzle-orm": "^0.45.2",
    "exceljs": "^4.4.0",
    "next": "16.3.3",
    "papaparse": "^5.7.0",
    "postgres": "^3.4.9",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "zod": "^4.5.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/papaparse": "^5.5.2",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9",
    "eslint-config-next": "16.3.3",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^4.1.11"
  }
}
