# JobScanV2 — copy to .env.local and fill in.
# .env.local is git-ignored. Never commit real values.

# --- Database (Supabase) ---------------------------------------------------
# Supabase dashboard → Project Settings → Database → Connection string.
#
# DATABASE_URL: the TRANSACTION POOLER (port 6543). Used at runtime, including
#   on Vercel. The client sets prepare:false because the pooler cannot hold
#   prepared statements.
# DIRECT_URL:   the DIRECT connection (port 5432). Used only by drizzle-kit for
#   migrations. Running DDL through the pooler fails in confusing ways.
DATABASE_URL="postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres"
DIRECT_URL="postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres"

# --- Access control (D3) ---------------------------------------------------
# Single shared password gating the deployed app. Leave unset locally to skip
# the gate; REQUIRED on Vercel, where the app is on a public URL.
APP_PASSWORD=""

# --- AI execution (D4) -----------------------------------------------------
# mock         → fixtures, no Claude Code, zero subscription usage.
# claude_local → the worker on your Mac runs `claude -p` against Claude Pro.
AI_PROVIDER="mock"

# --- Models (D5) -----------------------------------------------------------
# Per-task so the Opus/Sonnet split is an env change, not a code change.
# If Pro quota becomes the bottleneck, drop MODEL_CV to claude-sonnet-5.
MODEL_SCORING="claude-sonnet-5"
MODEL_CV="claude-opus-5"
AI_EFFORT="high"

# --- Business rules --------------------------------------------------------
# C1 resolved: 14 days of no response before an application reads as Pending.
DEEMED_PENDING_DAYS="14"

# --- Worker ----------------------------------------------------------------
WORKER_POLL_MS="10000"
# Optional: absolute path to the claude binary if it is not on PATH.
CLAUDE_BIN=""
