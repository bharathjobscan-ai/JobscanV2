# JobScanV2 — copy to .env.local and fill in.
# .env.local is git-ignored. Never commit real values.

# --- Database (Supabase) ---------------------------------------------------
# Supabase dashboard → Project Settings → Database → Connection string.
#
# DATABASE_URL: the TRANSACTION POOLER (port 6543). Used at runtime, including
#   on Vercel. The client sets prepare:false because the pooler cannot hold
#   prepared statements.
# DIRECT_URL:   the DIRECT connection (port 5432). Used only by drizzle-kit for
#   migrations. Running DDL through the pooler fails in confusing ways.
DATABASE_URL="postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres"
DIRECT_URL="postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres"

# --- Access control (D3) ---------------------------------------------------
# Single shared password gating the deployed app. Leave unset locally to skip
# the gate; REQUIRED on Vercel, where the app is on a public URL.
APP_PASSWORD=""

# --- AI execution (D4) -----------------------------------------------------
# mock → fixtures everywhere, nothing generated, nothing charged.
# live → route per task using the providers below.
#
# Both live providers are plain HTTPS calls, so nothing needs a local machine
# running and everything works from Vercel. The Claude Code worker is retired.
AI_PROVIDER="mock"

# Per-task routing. Gemini's Google Search grounding resolves UK sponsor-register
# entries that Claude Code could not; Claude leads on long-form documents.
PROVIDER_SCORING="gemini_api"
PROVIDER_CV="anthropic_api"

GEMINI_API_KEY=""        # aistudio.google.com/apikey
ANTHROPIC_API_KEY=""     # console.anthropic.com

# Discover Gemini names with `npm run ai:models` rather than guessing.
MODEL_SCORING_GEMINI="gemini-3.1-pro-preview"
MODEL_CV_GEMINI="gemini-3.1-pro-preview"

# Anthropic models (D5).
MODEL_SCORING="claude-sonnet-5"
MODEL_CV="claude-opus-5"
AI_EFFORT="medium"

# --- Business rules --------------------------------------------------------
# C1 resolved: 14 days of no response before an application reads as Pending.
DEEMED_PENDING_DAYS="14"

